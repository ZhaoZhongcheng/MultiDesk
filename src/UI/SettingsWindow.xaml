<Window x:Class="MultiDesk.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="多桌面助手 - 设置"
        Width="1040" Height="700"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FF141824"
        Foreground="#FFE8ECF5"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Closing="SettingsWindow_Closing"
        Closed="SettingsWindow_Closed"
        IsVisibleChanged="SettingsWindow_IsVisibleChanged">
    <!-- 无边框窗口 + 自定义标题栏；WindowChrome 提供拖拽改大小边框 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MultiDesk;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 侧栏：单个桌面项 -->
            <DataTemplate x:Key="DesktopItemTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="6"
                            Background="{StaticResource IconChipBgBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding IndexText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding IconCountText}" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource AccentBrush}" CornerRadius="8"
                            Padding="7,1" VerticalAlignment="Center"
                            Visibility="{Binding CurrentBadgeVisibility}">
                        <TextBlock Text="当前" FontSize="10" Foreground="White"/>
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- 桌面图标列表项 -->
            <DataTemplate x:Key="IconItemTemplate">
                <Border x:Name="Row" Background="Transparent" CornerRadius="8"
                        Padding="10,6" Margin="0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="6"
                                Background="{StaticResource IconChipBgBrush}" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding IconSource}" Width="28" Height="28" Stretch="Uniform"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding TargetPath}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="打开位置" Style="{StaticResource SmallActionButtonStyle}"
                                    Click="IconOpenLocation_Click"/>
                            <Button Content="移除" Style="{StaticResource SmallActionButtonStyle}"
                                    Click="IconRemove_Click" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBgBrush}"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- 快捷键列表项 -->
            <DataTemplate x:Key="HotkeyItemTemplate">
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource IconChipBgBrush}" CornerRadius="6"
                            Padding="9,4" MinWidth="138" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding KeyText}" FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#FF141824">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ======================= 自定义标题栏 ======================= -->
            <Border Grid.Row="0" Background="#FF171E2D" BorderBrush="#FF232C40" BorderThickness="0,0,0,1">
                <Grid x:Name="TitleBar" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6"
                                Background="{StaticResource AccentGradientBrush}">
                            <TextBlock Text="多" Foreground="White" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="多桌面助手" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Text="MultiDesk · 设置" FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}"
                                Click="Minimize_Click" ToolTip="最小化"
                                AutomationProperties.Name="最小化" AutomationProperties.AutomationId="MinimizeButton">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}"
                                Click="CloseToTray_Click" ToolTip="关闭到系统托盘"
                                AutomationProperties.Name="关闭到托盘" AutomationProperties.AutomationId="CloseButton">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= 主体：侧栏 + 右侧内容 ======================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ 左侧栏 ============ -->
                <Border Grid.Column="0" Background="#FF1B2233"
                        BorderBrush="#FF232C40" BorderThickness="0,0,1,0">
                    <Grid Margin="16,16,16,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 品牌标题 -->
                        <StackPanel Grid.Row="0" Margin="4,0,0,16">
                            <TextBlock Text="多桌面助手" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="MultiDesk · 多虚拟桌面管理" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 桌面列表标题 -->
                        <Grid Grid.Row="1" Margin="4,0,4,7">
                            <TextBlock Text="桌面" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="DesktopCountText" Text="共 0 个" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 桌面列表 -->
                        <ListBox x:Name="DesktopList" Grid.Row="2"
                                 Style="{StaticResource TransparentListBoxStyle}"
                                 ItemContainerStyle="{StaticResource DesktopListItemStyle}"
                                 ItemTemplate="{StaticResource DesktopItemTemplate}"
                                 PreviewMouseLeftButtonDown="DesktopList_PreviewMouseLeftButtonDown"
                                 SelectionChanged="DesktopList_SelectionChanged"/>

                        <!-- 桌面操作按钮 -->
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="NewDesktopButton" Content="＋ 新建" Grid.Column="0"
                                    Style="{StaticResource ToolButtonStyle}" Padding="4,5"
                                    HorizontalContentAlignment="Center" Click="NewDesktop_Click"
                                    Margin="0,0,5,0" ToolTip="新建桌面"/>
                            <Button x:Name="MoveUpButton" Content="↑ 上移" Grid.Column="1"
                                    Style="{StaticResource ToolButtonStyle}" Padding="4,5"
                                    HorizontalContentAlignment="Center" Click="MoveUp_Click"
                                    Margin="0,0,5,0" ToolTip="把当前选中的桌面前移"/>
                            <Button x:Name="MoveDownButton" Content="↓ 下移" Grid.Column="2"
                                    Style="{StaticResource ToolButtonStyle}" Padding="4,5"
                                    HorizontalContentAlignment="Center" Click="MoveDown_Click"
                                    Margin="0,0,5,0" ToolTip="把当前选中的桌面后移"/>
                            <Button x:Name="DeleteDesktopButton" Content="删除" Grid.Column="3"
                                    Style="{StaticResource ToolButtonStyle}" Padding="4,5"
                                    HorizontalContentAlignment="Center" Click="DeleteDesktop_Click"
                                    ToolTip="删除选中的桌面"/>
                        </Grid>

                        <!-- 分隔线 -->
                        <Border Grid.Row="4" Height="1" Background="{StaticResource CardBorderBrush}"
                                Margin="0,14,0,10"/>

                        <!-- 页面导航 -->
                        <StackPanel Grid.Row="5">
                            <Button x:Name="NavGeneralButton" Style="{StaticResource NavButtonStyle}"
                                    Click="NavGeneral_Click" Margin="0,0,0,2" ToolTip="常规设置"
                                    AutomationProperties.Name="常规设置" AutomationProperties.AutomationId="NavGeneral">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="常规设置" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavHelpButton" Style="{StaticResource NavButtonStyle}"
                                    Click="NavHelp_Click" ToolTip="帮助与说明"
                                    AutomationProperties.Name="帮助与说明" AutomationProperties.AutomationId="NavHelp">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="帮助与说明" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 版本号 -->
                        <TextBlock Grid.Row="6" Text="版本 1.2.1" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="12,10,0,0"/>
                    </Grid>
                </Border>

                <!-- ============ 右侧内容区 ============ -->
                <Grid Grid.Column="1" Margin="26,18,26,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 首次运行欢迎条 -->
                    <Border x:Name="WelcomeBanner" Grid.Row="0" Margin="0,0,0,14"
                            CornerRadius="10" Padding="16,11" Background="#FF233250"
                            BorderBrush="#FF3A5480" BorderThickness="1"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="欢迎使用多桌面助手！已自动把你现有的桌面图标导入到「工作桌面」，其他桌面默认清空；在桌面空白处右键可打开菜单。"
                                       Foreground="{StaticResource TextBrush}" FontSize="12.5"
                                       TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="19"/>
                            <Button Grid.Column="2" Content="知道了" Click="WelcomeDismiss_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="12,5" FontSize="12" Margin="14,0,0,0"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">

                        <!-- ========== 页面 A：桌面设置 ========== -->
                        <Grid x:Name="DesktopPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 页头 -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="桌面设置" Style="{StaticResource PageTitleStyle}"/>
                                    <TextBlock x:Name="DesktopPageSubtitle" Text="选择一个桌面开始配置"
                                               Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="SwitchDesktopButton" Content="切换到该桌面"
                                        Style="{StaticResource ToolButtonStyle}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="SwitchDesktop_Click" ToolTip="点击切换到左侧选中的桌面"/>
                            </Grid>

                            <!-- 桌面名称 -->
                            <Border Grid.Row="1" Style="{StaticResource CardStyle}"
                                    Padding="18,13" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="桌面名称" Style="{StaticResource CardTitleStyle}"
                                               Margin="0,0,0,9"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="名称" Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,0,12,0"/>
                                        <TextBox x:Name="NameBox" Grid.Column="1"
                                                 Style="{StaticResource DarkTextBoxStyle}"
                                                 AutomationProperties.Name="桌面名称"
                                                 MaxLength="40" KeyDown="NameBox_KeyDown"
                                                 LostFocus="NameBox_LostFocus"
                                                 ToolTip="按 Enter 或点击别处即可保存名称"/>
                                        <CheckBox x:Name="ShowNameBadgeCheck" Grid.Column="2"
                                                  Style="{StaticResource DarkCheckBoxStyle}"
                                                  Content="在桌面右下角显示桌面名称"
                                                  Margin="18,0,0,0" VerticalAlignment="Center"
                                                  Checked="ShowNameBadge_Changed"
                                                  Unchecked="ShowNameBadge_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 壁纸 -->
                            <Border Grid.Row="2" Style="{StaticResource CardStyle}"
                                    Padding="18,13" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="壁纸" Style="{StaticResource CardTitleStyle}"
                                                   Margin="0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <RadioButton x:Name="RadioWallpaperSystem"
                                                         Content="跟随当前桌面壁纸（推荐）"
                                                         GroupName="WallpaperMode" Tag="System"
                                                         Style="{StaticResource DarkRadioButtonStyle}"
                                                         Margin="0,0,20,0"
                                                         Checked="WallpaperMode_Changed"/>
                                            <RadioButton x:Name="RadioWallpaperImage" Content="图片"
                                                         GroupName="WallpaperMode" Tag="Image"
                                                         Style="{StaticResource DarkRadioButtonStyle}"
                                                         Margin="0,0,20,0"
                                                         Checked="WallpaperMode_Changed"/>
                                            <RadioButton x:Name="RadioWallpaperSolid" Content="纯色"
                                                         GroupName="WallpaperMode" Tag="SolidColor"
                                                         Style="{StaticResource DarkRadioButtonStyle}"
                                                         Checked="WallpaperMode_Changed"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 跟随当前桌面壁纸：说明 -->
                                    <TextBlock x:Name="WallpaperSystemHint"
                                               Text="透明显示真实桌面，支持 Wallpaper Engine 等壁纸软件：Windows 壁纸、动态壁纸都会实时可见。"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Margin="0,13,0,0"/>

                                    <!-- 图片壁纸 -->
                                    <Grid x:Name="WallpaperImagePanel" Margin="0,13,0,0"
                                          Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="WallpaperPathBox"
                                                 Style="{StaticResource ReadOnlyTextBoxStyle}"
                                                 Text="（未选择图片）"
                                                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <Button Grid.Column="1" Content="选择图片…"
                                                Style="{StaticResource ToolButtonStyle}"
                                                Margin="10,0,0,0" Click="ChooseWallpaper_Click"/>
                                        <ComboBox x:Name="FitCombo" Grid.Column="2" Width="118"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  Margin="10,0,0,0" ToolTip="壁纸填充方式"
                                                  SelectionChanged="FitCombo_SelectionChanged"/>
                                    </Grid>

                                    <!-- 纯色壁纸 -->
                                    <Grid x:Name="WallpaperSolidPanel" Margin="0,13,0,0"
                                          Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="ColorPreview" Width="34" Height="34"
                                                CornerRadius="7" Background="#FF1B1F2A"
                                                BorderBrush="#FF3A4763" BorderThickness="1"/>
                                        <TextBox x:Name="ColorHexBox" Grid.Column="1" Margin="12,0,0,0"
                                                 Style="{StaticResource DarkTextBoxStyle}" MaxLength="9"
                                                 ToolTip="支持 #RRGGBB 或 #AARRGGBB"
                                                 TextChanged="ColorHexBox_TextChanged"/>
                                        <TextBlock Grid.Column="2" Text="颜色值（#RRGGBB / #AARRGGBB）"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <WrapPanel x:Name="PresetColorsPanel" Grid.Column="3"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 图标外观 -->
                            <Border Grid.Row="3" Style="{StaticResource CardStyle}"
                                    Padding="18,13" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="图标外观" Style="{StaticResource CardTitleStyle}"
                                                       Margin="0"/>
                                            <TextBlock Text="图标大小" Style="{StaticResource FieldLabelStyle}"
                                                       Margin="16,0,8,0"/>
                                            <ComboBox x:Name="IconSizeCombo" Width="112"
                                                      Style="{StaticResource DarkComboBoxStyle}"
                                                      ToolTip="设置桌面图标的显示大小（取消“与 Windows 桌面图标大小/间距一致”后可用）"
                                                      AutomationProperties.Name="图标大小"
                                                      SelectionChanged="IconSizeCombo_SelectionChanged"/>
                                            <TextBlock x:Name="IconSizeHint" Text="跟随 Windows"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Visibility="Collapsed"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button Content="整理图标" Style="{StaticResource ToolButtonStyle}"
                                                    Margin="0,0,8,0" Click="ArrangeIcons_Click"
                                                    ToolTip="按当前图标大小重新对齐所有图标"/>
                                            <Button Content="按名称排序" Style="{StaticResource ToolButtonStyle}"
                                                    Click="SortIconsByName_Click"
                                                    ToolTip="按名称排序后重新对齐所有图标"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="MatchWindowsIconsCheck"
                                              Content="与 Windows 桌面图标大小/间距一致（推荐）"
                                              Style="{StaticResource DarkCheckBoxStyle}"
                                              Margin="0,10,0,0"
                                              AutomationProperties.Name="与 Windows 桌面图标一致"
                                              Checked="MatchWindowsIconsCheck_Changed"
                                              Unchecked="MatchWindowsIconsCheck_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox x:Name="AutoArrangeCheck" Content="自动排列（网格对齐）"
                                                  Style="{StaticResource DarkCheckBoxStyle}"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="自动排列"
                                                  Checked="AutoArrangeCheck_Changed"
                                                  Unchecked="AutoArrangeCheck_Changed"/>
                                        <TextBlock Text="取消勾选后可自由摆放图标（可重叠）。"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 桌面图标 -->
                            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="18,13">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="桌面图标" Style="{StaticResource CardTitleStyle}"
                                                       Margin="0"/>
                                            <Border Background="{StaticResource IconChipBgBrush}"
                                                    CornerRadius="9" Padding="8,2" Margin="10,0,0,0">
                                                <TextBlock x:Name="IconCountText" Text="0 个" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="可把文件 / 文件夹直接拖进列表"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button Content="添加文件…" Style="{StaticResource ToolButtonStyle}"
                                                    Margin="0,0,8,0" Click="AddFiles_Click"/>
                                            <Button Content="添加文件夹…" Style="{StaticResource ToolButtonStyle}"
                                                    Click="AddFolder_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border x:Name="IconDropZone" Grid.Row="1" MinHeight="120"
                                            Background="#FF171E2C" BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="10"
                                            AllowDrop="True"
                                            DragEnter="IconDropZone_DragEnter"
                                            DragOver="IconDropZone_DragOver"
                                            DragLeave="IconDropZone_DragLeave"
                                            Drop="IconDropZone_Drop">
                                        <Grid>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Padding="6,5">
                                                <ItemsControl x:Name="IconItems"
                                                              ItemTemplate="{StaticResource IconItemTemplate}"/>
                                            </ScrollViewer>
                                            <StackPanel x:Name="IconEmptyState" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" Margin="20"
                                                        IsHitTestVisible="False">
                                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="26"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="还没有图标" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                <TextBlock Text="点击右上角「添加文件…」「添加文件夹…」，或把文件 / 文件夹拖到这里"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           HorizontalAlignment="Center" TextAlignment="Center"
                                                           MaxWidth="380" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ========== 页面 B：常规设置 ========== -->
                        <ScrollViewer x:Name="GeneralPage" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,0">
                            <StackPanel Margin="0,0,2,10">
                                <TextBlock Text="常规设置" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="启动方式、窗口管理、快捷键与数据目录"
                                           Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,16"/>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="启动" Style="{StaticResource CardTitleStyle}"
                                                   Margin="0,0,0,10"/>
                                        <CheckBox x:Name="StartWithWindowsCheck" Content="开机自动启动"
                                                  Style="{StaticResource DarkCheckBoxStyle}"
                                                  Checked="StartWithWindows_Changed"
                                                  Unchecked="StartWithWindows_Changed"/>
                                        <TextBlock Text="登录 Windows 后自动在后台运行，并在系统托盘中显示图标（写入当前用户注册表 Run 项）。"
                                                   Style="{StaticResource CaptionTextStyle}" Margin="27,7,0,0"/>
                                        <CheckBox x:Name="RestrictedPromptCheck" Content="启动时检测并提示受限模式"
                                                  Style="{StaticResource DarkCheckBoxStyle}"
                                                  Margin="0,14,0,0"
                                                  AutomationProperties.Name="启动时检测并提示受限模式"
                                                  Checked="RestrictedPromptCheck_Changed"
                                                  Unchecked="RestrictedPromptCheck_Changed"/>
                                        <TextBlock Text="关闭后，从聊天软件 / 沙箱等受限环境启动时不再弹提示，直接以内置回退模式运行；仍可从托盘菜单「以完整权限重启」。"
                                                   Style="{StaticResource CaptionTextStyle}" Margin="27,7,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="窗口管理" Style="{StaticResource CardTitleStyle}"
                                                   Margin="0,0,0,10"/>
                                        <CheckBox x:Name="PauseCheck" Content="暂停窗口管理"
                                                  Style="{StaticResource DarkCheckBoxStyle}"
                                                  Checked="PauseCheck_Changed"
                                                  Unchecked="PauseCheck_Changed"/>
                                        <TextBlock Text="暂停后，所有桌面的窗口都会显示，不再隐藏非当前桌面的窗口。"
                                                   Style="{StaticResource CaptionTextStyle}" Margin="27,7,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="27,12,0,0">
                                            <Button Content="立即恢复所有窗口"
                                                    Style="{StaticResource ToolButtonStyle}"
                                                    Click="RestoreAll_Click"/>
                                            <TextBlock x:Name="PauseStatusText" Text="当前状态：正在管理窗口"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="快捷键" Style="{StaticResource CardTitleStyle}"
                                                   Margin="0,0,0,10"/>
                                        <ItemsControl x:Name="HotkeyItems"
                                                      ItemTemplate="{StaticResource HotkeyItemTemplate}"/>
                                        <TextBlock Text="提示：也可以右键单击系统托盘中的多桌面助手图标，在菜单里切换桌面。"
                                                   Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="数据目录" Style="{StaticResource CardTitleStyle}"
                                                   Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="DataDirBox"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"
                                                     AutomationProperties.Name="数据目录"
                                                     Text="（未知）"
                                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            <Button Grid.Column="1" Content="打开目录"
                                                    Style="{StaticResource ToolButtonStyle}"
                                                    Margin="10,0,0,0" Click="OpenDataDir_Click"/>
                                        </Grid>
                                        <TextBlock Text="配置、备份与日志保存在此目录；复制该目录即可备份或迁移设置。"
                                                   Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="退出程序" Style="{StaticResource CardTitleStyle}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="退出后会立即恢复所有被隐藏的窗口，并从系统托盘移除图标。"
                                                       Style="{StaticResource CaptionTextStyle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="退出多桌面助手"
                                                Style="{StaticResource DangerButtonStyle}"
                                                VerticalAlignment="Center" Margin="16,0,0,0"
                                                Click="ExitApp_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ========== 页面 C：帮助与说明 ========== -->
                        <ScrollViewer x:Name="HelpPage" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,0">
                            <StackPanel Margin="0,0,2,10">
                                <TextBlock Text="帮助与说明" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="了解多桌面助手的工作方式与注意事项"
                                           Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,16"/>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="使用说明" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                                                   Text="· 一个桌面 = 一套独立的图标和壁纸。程序默认创建「工作桌面」和「游戏桌面」，你可以在左侧栏新建任意多个桌面。"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                                                   Text="· 在左侧栏选中一个桌面，即可修改它的名称、壁纸和图标；点击「切换到该桌面」或按 Ctrl+Alt+数字 立即切换。"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                                                   Text="· 把文件、文件夹或快捷方式拖进「桌面图标」列表即可添加图标。在「图标外观」中推荐勾选「与 Windows 桌面图标大小/间距一致」，图标会自动对齐 Windows 桌面；取消后可自定义小 32 / 中 48 / 大 64。勾选「自动排列」时图标吸附网格，取消后可自由摆放（允许重叠），也可以点「整理图标」「按名称排序」重新排版。"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                                                   Text="· 在桌面空白处单击右键，会弹出 Windows 原生的桌面菜单（查看、排序、刷新、新建等），这些操作只影响当前虚拟桌面的图标，不会影响其他桌面；在图标上单击右键，则弹出多桌面助手的图标菜单（打开、打开位置、移除等）。"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                                                   Text="· 双击图标即可启动对应程序，新打开的窗口会自动归属到当前桌面；在别的桌面不会再看到它。"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                                                   Text="· 每个桌面的图标集合可以为空。不想在桌面显示内容时，把图标全部移除即可，程序不会删除磁盘上的任何文件。"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                   Text="· 程序常驻系统托盘：关闭设置窗口只是隐藏窗口；只有托盘菜单里的「退出」或本设置窗口里的「退出多桌面助手」才会真正退出。"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="注意事项" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                                                   Text="· 切换桌面不会结束任何程序，只是把非当前桌面的窗口隐藏起来。下载、音乐、游戏等都会继续在后台运行。"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                                                   Text="· 以管理员权限运行的程序，普通权限下的多桌面助手可能无法隐藏或恢复它们的窗口。遇到这种情况可以勾选「暂停窗口管理」临时全部显示，或以管理员身份运行本程序。"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                                                   Text="· 建议直接双击 MultiDesk.exe 以普通用户权限启动；如果从聊天软件、沙箱或其他受限环境启动，程序会提示「受限模式」。可在常规设置中关闭「启动时检测并提示受限模式」，之后将静默使用内置回退模式；需要完整权限时，随时可从托盘菜单「以完整权限重启」。"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                                                   Text="· 全屏独占游戏在切换桌面时可能出现闪烁或短暂黑屏，建议游戏使用「无边框窗口」模式。"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                                                   Text="· 如果程序异常崩溃，重新启动后会自动恢复上一次被隐藏的窗口（内置看门狗机制），不会让窗口「消失」在系统里。"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                                                   Text="· 选择「跟随当前桌面壁纸」时，桌面图层透明显示真实桌面：Windows 壁纸、Wallpaper Engine 等动态壁纸都会实时可见；选择「图片 / 纯色」时桌面图层会覆盖真实壁纸，退出程序后立即恢复原样。"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                                                   Text="· 关闭「自动排列」后图标可以自由摆放、允许重叠；调整图标大小、更换显示器或分辨率后，建议点一下「整理图标」重新对齐。"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                                                   Text="· 「开机自动启动」通过写入注册表 HKCU\Software\Microsoft\Windows\CurrentVersion\Run 实现，可随时在常规设置中关闭。"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                   Text="· 图标位置按虚拟屏幕坐标保存，每个桌面的图标互不影响。"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="版本信息" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="多桌面助手 MultiDesk 1.2.1" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
                                        <TextBlock Text="运行环境：Windows 10 / 11 · .NET Framework 4.8 · WPF"
                                                   Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,3"/>
                                        <TextBlock Text="每桌面独立图标与壁纸 · 切换桌面不结束程序 · 崩溃自动恢复窗口"
                                                   Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
