<Window x:Class="MultiDesk.UI.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载多桌面助手" Height="520" Width="580"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF171B24"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        ShowInTaskbar="True">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="卸载多桌面助手 MultiDesk"
                   FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
        <TextBlock Grid.Row="1" Margin="0,9,0,0" TextWrapping="Wrap" FontSize="12.5"
                   Foreground="#FFD6DCE8"
                   Text="卸载前会自动请求程序退出，并恢复被隐藏的窗口与系统桌面图标。"/>

        <Border Grid.Row="2" Margin="0,16,0,0" Background="#FF202634" CornerRadius="6" Padding="14,11">
            <StackPanel>
                <TextBlock Text="程序位置" Foreground="#FFAEB8CA" FontSize="11.5"/>
                <TextBlock x:Name="TargetPathText" Margin="0,5,0,0" TextWrapping="Wrap"
                           Foreground="#FFFFFFFF" FontSize="12.5"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,14,0,0" Background="#FF202634" CornerRadius="6" Padding="14,12">
            <StackPanel>
                <TextBlock Text="卸载将删除以下内容：" Foreground="#FFFFFFFF" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Margin="0,9,0,0" Foreground="#FFE7EBF3" FontSize="12.5" TextWrapping="Wrap"
                           Text="· 程序文件与启动/卸载快捷方式（MultiDesk.exe、图标、使用说明等）"/>
                <TextBlock Margin="0,5,0,0" Foreground="#FFE7EBF3" FontSize="12.5" TextWrapping="Wrap"
                           Text="· 桌面 / 开始菜单 / 任务栏固定区中的本程序快捷方式"/>
                <TextBlock Margin="0,5,0,0" Foreground="#FFE7EBF3" FontSize="12.5" TextWrapping="Wrap"
                           Text="· 开机自动启动项与 Windows 11 托盘图标设置"/>
                <TextBlock Margin="0,5,0,0" Foreground="#FFFFB86B" FontSize="12.5" TextWrapping="Wrap"
                           Text="· 配置与桌面图标数据（MultiDesk-data，删除后不可恢复）"/>
                <TextBlock Margin="0,9,0,0" Foreground="#FFAEB8CA" FontSize="11.5" TextWrapping="Wrap"
                           Text="如需保留配置，请先把程序目录中的 MultiDesk-data 文件夹复制到其它位置。"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Margin="0,12,0,0" Background="#FF202634" CornerRadius="6" Padding="14,10"
                VerticalAlignment="Top">
            <ScrollViewer Height="80" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" Text="准备就绪。" TextWrapping="Wrap" FontSize="12"
                           Foreground="#FFD6DCE8"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="取消" Width="100" Height="36" Margin="0,0,12,0"
                    Click="Cancel_Click" Background="#FF2C3444" Foreground="#FFFFFFFF" BorderThickness="0"/>
            <Button x:Name="UninstallButton" Content="卸载" Width="120" Height="36" Click="Uninstall_Click"
                    Background="#FFD6453F" Foreground="#FFFFFFFF" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
